# Multi-stage Dockerfile for Image Processor
# Stage 1: Build the Go binary
FROM golang:alpine AS builder

# Install build dependencies
RUN apk add --no-cache git

# Set working directory
WORKDIR /build

# Copy go.mod and go.sum for dependency caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the image-processor binary
# CGO_ENABLED=0 for static binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags='-w -s -extldflags "-static"' \
    -o /build/image-processor \
    ./cmd/image-processor

# Stage 2: Create runtime image with dcmtk
FROM debian:12-slim

# Install runtime dependencies
# dcmtk: For dcm2img command (thumbnail generation)
# sqlite3: For database operations
# ca-certificates: For HTTPS/WebSocket
RUN apt-get update && apt-get install -y --no-install-recommends \
    dcmtk \
    sqlite3 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -g 1000 gateway && \
    useradd -u 1000 -g gateway -m gateway

# Create directories with proper permissions
RUN mkdir -p \
    /var/lib/pacs/storage \
    /var/lib/pacs/thumbnails \
    /var/lib/worklist && \
    chown -R gateway:gateway /var/lib/pacs /var/lib/worklist

# Copy binary from builder
COPY --from=builder /build/image-processor /usr/local/bin/image-processor
RUN chmod +x /usr/local/bin/image-processor

# Switch to non-root user
USER gateway

# Set environment variables with defaults
ENV PACS_DB_PATH=/var/lib/pacs/pacs.db \
    PACS_STORAGE_ROOT=/var/lib/pacs/storage \
    THUMBNAIL_ROOT=/var/lib/pacs/thumbnails \
    WORKLIST_DB_PATH=/var/lib/worklist/worklist.db \
    IMAGE_POLL_INTERVAL=2 \
    IMAGE_BATCH_SIZE=10 \
    THUMBNAIL_QUALITY=25 \
    THUMBNAIL_HEIGHT=188 \
    LOG_LEVEL=INFO

# Run the image processor
CMD ["/usr/local/bin/image-processor"]
